@{
    ViewData["Title"] = "Municipal Grievance Dashboard";
    var stats = ViewBag.Stats as CivicVoice.Application.Interfaces.DashboardStats ?? new();
    var recent = ViewBag.RecentGrievances as IEnumerable<CivicVoice.Domain.Entities.Grievance> ?? new List<CivicVoice.Domain.Entities.Grievance>();
}

<!-- Hero Welcome Section -->
<div class="p-4 p-md-5 mb-4 rounded-4 text-white position-relative overflow-hidden shadow-sm" style="background: linear-gradient(135deg, #1e3a8a 0%, #0f172a 100%);">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <span class="badge bg-primary bg-opacity-25 border border-primary text-light px-3 py-2 rounded-pill mb-3">
                <i class="bi bi-shield-check me-1"></i> Official Municipal Grievance Redressal Portal
            </span>
            <h1 class="display-5 fw-bold mb-3">Your Voice Shapes Our City</h1>
            <p class="lead mb-4 text-light text-opacity-75">
                Register complaints regarding water leakage, damaged roads, sanitation, streetlights, and drainage. Track resolution status in real-time with automated SLA tracking.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Grievances" asp-action="Create" class="btn btn-warning btn-lg rounded-pill px-4 fw-bold shadow-sm">
                    <i class="bi bi-plus-circle me-1"></i> Report a Grievance
                </a>
                <a asp-controller="Grievances" asp-action="Index" class="btn btn-outline-light btn-lg rounded-pill px-4">
                    <i class="bi bi-search me-1"></i> Track Grievance Status
                </a>
            </div>
        </div>
        <div class="col-lg-4 d-none d-lg-block text-center">
            <i class="bi bi-buildings text-light text-opacity-25" style="font-size: 10rem;"></i>
        </div>
    </div>
</div>

<!-- Real Database KPI Stat Cards -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card card-primary h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Total Grievances</div>
                    <div class="stat-value">@stats.TotalGrievances</div>
                </div>
                <div class="p-2 bg-primary bg-opacity-10 text-primary rounded-3">
                    <i class="bi bi-card-checklist fs-3"></i>
                </div>
            </div>
            <div class="small text-muted mt-2">All time registered municipal cases</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card card-warning h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Active / In Progress</div>
                    <div class="stat-value text-warning">@stats.OpenGrievances</div>
                </div>
                <div class="p-2 bg-warning bg-opacity-10 text-warning rounded-3">
                    <i class="bi bi-hourglass-split fs-3"></i>
                </div>
            </div>
            <div class="small text-muted mt-2">Currently being addressed by departments</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card card-success h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">Resolved Grievances</div>
                    <div class="stat-value text-success">@stats.ResolvedGrievances</div>
                </div>
                <div class="p-2 bg-success bg-opacity-10 text-success rounded-3">
                    <i class="bi bi-check-circle-fill fs-3"></i>
                </div>
            </div>
            <div class="small text-muted mt-2">Successfully closed &amp; verified</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card card-danger h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <div class="stat-label">SLA Breached</div>
                    <div class="stat-value text-danger">@stats.SlaBreach</div>
                </div>
                <div class="p-2 bg-danger bg-opacity-10 text-danger rounded-3">
                    <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                </div>
            </div>
            <div class="small text-muted mt-2">Unresolved past statutory deadline</div>
        </div>
    </div>
</div>

<!-- Recent Grievances Card -->
<div class="civic-card">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-clock-history me-2 text-primary"></i>Recent Municipal Grievances</h4>
            <p class="text-muted small mb-0">Live feed of public complaints across all municipal wards</p>
        </div>
        <a asp-controller="Grievances" asp-action="Index" class="btn btn-outline-primary btn-sm rounded-pill px-3">
            View All Grievances <i class="bi bi-arrow-right"></i>
        </a>
    </div>

    <div class="table-responsive">
        <table class="table civic-table align-middle">
            <thead>
                <tr>
                    <th>Grievance ID</th>
                    <th>Description</th>
                    <th>Ward</th>
                    <th>Category &amp; Dept</th>
                    <th>Status</th>
                    <th>SLA Deadline</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @await Html.PartialAsync("_GrievanceRows", recent)
            </tbody>
        </table>
    </div>
</div>

<!-- Architecture & Evaluation Quick Reference Guide -->
<div class="civic-card bg-light border-0">
    <h5 class="fw-bold mb-3 text-secondary"><i class="bi bi-mortarboard-fill me-2 text-primary"></i>Academic Demonstration &amp; Architecture Notes</h5>
    <div class="row g-3 small">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-3">
                <h6 class="fw-bold text-primary"><i class="bi bi-layers-half me-1"></i> Clean Architecture (.NET 10)</h6>
                <p class="text-muted mb-0">Separation of concerns: CivicVoice.Domain (Entities &amp; Enums), CivicVoice.Application (Interfaces, DTOs, Business Rules), CivicVoice.Infrastructure (EF Core 10, Repositories, SQL Server), CivicVoice.Web (MVC 10).</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-3">
                <h6 class="fw-bold text-success"><i class="bi bi-database-check me-1"></i> SQL Server Integration</h6>
                <p class="text-muted mb-0">Direct SQL Server Developer Edition integration: Custom View <code>vw_DepartmentSlaReport</code>, Stored Procedure <code>usp_SearchGrievances</code>, and Audit Trigger <code>trg_GrievanceStatusHistory</code>.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm p-3">
                <h6 class="fw-bold text-warning"><i class="bi bi-shield-lock-fill me-1"></i> Role-Based Access Control</h6>
                <p class="text-muted mb-0">Three full ASP.NET Core Identity roles: <strong>Citizen</strong> (register &amp; rate), <strong>Department Officer</strong> (claim &amp; resolve), and <strong>Commissioner</strong> (city-wide SLA governance &amp; CSV export).</p>
            </div>
        </div>
    </div>
</div>
