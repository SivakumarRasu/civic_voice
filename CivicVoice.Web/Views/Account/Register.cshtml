@model CivicVoice.Web.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register Civic Account";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="text-center mb-4">
            <h3 class="fw-bold">Create an Account</h3>
            <p class="text-muted small">Register as a Citizen, Department Officer, or Municipal Commissioner</p>
        </div>

        <div class="civic-card">
            <form asp-action="Register" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger small rounded-3" role="alert"></div>

                <div class="mb-3">
                    <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
                    <input asp-for="FullName" class="form-control" placeholder="John Doe" />
                    <span asp-validation-for="FullName" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">Official Email</label>
                    <input asp-for="Email" class="form-control" placeholder="user@domain.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Role" class="form-label fw-semibold">System Role</label>
                    <select asp-for="Role" class="form-select">
                        <option value="Citizen">Citizen (Report &amp; Track Grievances)</option>
                        <option value="DepartmentOfficer">Department Officer (Manage &amp; Resolve)</option>
                        <option value="Commissioner">Commissioner (Full Governance &amp; Analytics)</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold">Password</label>
                    <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">Confirm Password</label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="••••••••" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-semibold shadow-sm">
                    Complete Registration
                </button>
            </form>

            <div class="text-center mt-3 pt-3 border-top small text-muted">
                Already registered? <a asp-action="Login" class="text-primary fw-semibold text-decoration-none">Sign in here</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
