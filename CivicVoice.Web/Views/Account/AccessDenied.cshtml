@{
    ViewData["Title"] = "Access Restricted";
}

<div class="row justify-content-center text-center py-5">
    <div class="col-md-6">
        <div class="p-4 bg-danger bg-opacity-10 text-danger rounded-circle d-inline-flex mb-3">
            <i class="bi bi-shield-slash fs-1"></i>
        </div>
        <h2 class="fw-bold">Access Restricted</h2>
        <p class="text-muted">You do not have the required role or administrative permissions to access this municipal section.</p>
        <div class="d-flex justify-content-center gap-2 mt-4">
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                Return to Dashboard
            </a>
            <a asp-action="Login" class="btn btn-primary rounded-pill px-4">
                Switch Account
            </a>
        </div>
    </div>
</div>
