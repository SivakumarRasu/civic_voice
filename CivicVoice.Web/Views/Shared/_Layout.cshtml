<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CivicVoice Municipal Grievance System</title>
    
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <!-- Custom CivicVoice Stylesheet -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Academic Demo Role Quick Switcher Bar -->
    <div class="demo-bar d-flex flex-wrap justify-content-between align-items-center">
        <div class="d-flex align-items-center">
            <span class="me-2"><i class="bi bi-person-badge-fill me-1"></i><strong>Academic Evaluation Demo Logins:</strong></span>
            <a asp-controller="Account" asp-action="QuickLogin" asp-route-role="citizen"><i class="bi bi-person"></i> Citizen</a>
            <a asp-controller="Account" asp-action="QuickLogin" asp-route-role="officer"><i class="bi bi-cone-striped"></i> Roads Officer</a>
            <a asp-controller="Account" asp-action="QuickLogin" asp-route-role="water"><i class="bi bi-droplet-half"></i> Water Officer</a>
            <a asp-controller="Account" asp-action="QuickLogin" asp-route-role="commissioner"><i class="bi bi-shield-check"></i> Commissioner</a>
        </div>
        <div>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <span class="badge bg-primary me-2">Role: @(User.IsInRole("Commissioner") ? "Commissioner" : User.IsInRole("DepartmentOfficer") ? "Department Officer" : "Citizen")</span>
                <span>Active: <strong>@User.Identity.Name</strong></span>
            }
            else
            {
                <span class="text-secondary"><i class="bi bi-info-circle"></i> Browsing as Guest</span>
            }
        </div>
    </div>

    <!-- Main Navigation Header -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-civic navbar-dark">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-building text-primary"></i>
                    <span>CivicVoice</span>
                    <span class="brand-badge">Municipal</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCivic" aria-controls="navbarCivic" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarCivic">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Grievances" asp-action="Index">
                                <i class="bi bi-card-list me-1"></i> All Grievances
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning fw-semibold" asp-controller="Grievances" asp-action="Create">
                                <i class="bi bi-plus-circle-fill me-1"></i> Report Complaint
                            </a>
                        </li>
                        @if (User.IsInRole("DepartmentOfficer") || User.IsInRole("Commissioner"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Officer" asp-action="Dashboard">
                                    <i class="bi bi-briefcase me-1"></i> Officer Portal
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Commissioner"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-info fw-semibold" asp-controller="Commissioner" asp-action="Dashboard">
                                    <i class="bi bi-graph-up-arrow me-1"></i> SLA Analytics
                                </a>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-2">
                                <span class="nav-link text-white-50 small">
                                    <i class="bi bi-person-circle me-1"></i>@User.Identity.Name
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light btn-sm rounded-pill px-3">
                                        <i class="bi bi-box-arrow-right me-1"></i> Logout
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="btn btn-outline-light btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Login
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus me-1"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Global Alert Banners -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Page Body -->
    <main role="main" class="main-content py-4">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <!-- Footer -->
    <footer class="civic-footer mt-auto">
        <div class="container text-center">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start">
                    <p class="mb-0 fw-semibold">CivicVoice &mdash; Municipal Grievance Redressal System</p>
                    <p class="small text-muted mb-0">Built with ASP.NET Core MVC 10, SQL Server, Clean Architecture &amp; xUnit</p>
                </div>
                <div class="col-md-6 text-md-end mt-2 mt-md-0">
                    <span class="badge bg-secondary">Milestone 1 (M1) Verified</span>
                    <span class="text-muted ms-2">&copy; @DateTime.UtcNow.Year Municipal Corporation</span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
